# Copy to .env and fill with real values. .env is gitignored.

# Pinecone (get from app.pinecone.io)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_REGION=us-east-1

# NVIDIA NIM (free tier via build.nvidia.com), OpenAI-compatible.
# One key covers chat and embeddings.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your-nvidia-nim-api-key
NIM_MODEL=deepseek-ai/deepseek-v4-flash
NIM_RPM_LIMIT=40
# reasoning effort sent per call only when non-empty (NIM compat varies by model)
REASONING_EFFORT=

# Embeddings (defaults to the NIM values above — only set to override)
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_DIMENSION=2048  # native size; 384/512/768/1024/2048 supported, must match Pinecone index